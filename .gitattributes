# One line ending across the tree. Jekyll does not care, but whole-file diffs
# caused by an editor switching CRLF/LF do.
* text=auto eol=lf
*.png binary
*.webp binary
*.jpg binary
*.mp4 binary
*.webm binary
*.woff2 binary
# favicon.ico and favicon.svg were classified only by git's NUL heuristic.
# Say it explicitly instead: an .ico is binary, and an .svg is text that must
# never have its line endings rewritten on the way into a commit.
*.ico binary
*.svg -text
